# Copy this file to .env.local and change what you need. .env.local is
# git-ignored; never commit real passwords or tokens.
#
# Without .env.local the app runs in DEMO MODE: the admin opens with the
# password "demo-edgar" and nothing is sent anywhere. Demo mode switches itself
# off as soon as ADMIN_PASSWORD, TELEGRAM_BOT_TOKEN, GOOGLE_CALENDAR_ENABLED=true
# or a non-mock SMS_PROVIDER is set (or with DEMO_MODE=false).

# Admin password. The demo value below is public (it is in the README) -
# replace it with your own long password before putting the site online.
ADMIN_PASSWORD=demo-edgar

# Set to false to forbid the demo password even when nothing else is configured.
DEMO_MODE=

# Key used to hash stored admin session tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty a random key is generated per process, which logs the admin out
# on every restart. Changing this value invalidates all existing sessions.
ADMIN_SESSION_SECRET=

# IANA time zone of the clinic. All schedule times (working hours, bookings,
# "today", Google Calendar busy times) are interpreted in this zone.
CLINIC_TIMEZONE=Asia/Yerevan

# Optional Telegram bot for the doctor (new requests with confirm/cancel buttons).
# Leave empty for the demo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required for the Telegram webhook. Without it every callback is rejected.
# Pass the same value as secret_token when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional Google Calendar sync through a service account. Keep false for the demo.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# SMS: keep mock during development (mock only logs, never sends).
# Real sending stays OFF: dispatch happens only when SMS_AUTO_SEND_ENABLED=true
# AND the in-app "Auto-send" setting is enabled AND a real provider is wired.
SMS_PROVIDER=mock
SMS_AUTO_SEND_ENABLED=false

# Default country used when normalizing local numbers (Armenia).
SMS_DEFAULT_COUNTRY=AM
SMS_DEFAULT_COUNTRY_CODE=+374

# Future SIM / GSM-modem / phone-gateway sender (the doctor's own SIM number).
# Leave empty for now. Connect manually later, then set SMS_PROVIDER=gsm.
# SMS_SENDER_PHONE is shown in /admin/sms as configuration info only — it does
# NOT enable real sending while SMS_PROVIDER=mock.
SMS_SENDER_PHONE=
SMS_GSM_PORT=
SMS_GATEWAY_URL=

# Optional future HTTP/API provider (not used while SMS_PROVIDER=mock).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
